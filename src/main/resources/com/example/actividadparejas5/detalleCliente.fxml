<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<BorderPane fx:id="panelRaiz" prefHeight="590.0" prefWidth="560.0"
            onKeyPressed="#onTeclaPresionada"
            xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.actividadparejas5.controllers.DetalleClienteController">

    <top>
        <VBox spacing="3.0">
            <padding>
                <Insets bottom="15.0" left="25.0" right="25.0" top="20.0" />
            </padding>
            <children>
                <Label text="Información registrada"
                       style="-fx-font-size: 16px; -fx-font-weight: bold;" />
                <Label text="Datos recibidos desde la tabla de consulta"
                       style="-fx-text-fill: #5c5850;" />
            </children>
        </VBox>
    </top>

    <center>
        <VBox spacing="15.0">
            <padding>
                <Insets left="25.0" right="25.0" />
            </padding>
            <children>

                <HBox spacing="18.0">
                    <children>

                        <ImageView fx:id="imgFotografia"
                                   fitHeight="124.0" fitWidth="124.0"
                                   pickOnBounds="true" preserveRatio="true"
                                   style="-fx-background-color: #e7e5df;" />

                        <GridPane hgap="10.0" vgap="8.0" HBox.hgrow="ALWAYS">
                            <columnConstraints>
                                <ColumnConstraints hgrow="NEVER" minWidth="10.0" prefWidth="115.0" />
                                <ColumnConstraints hgrow="ALWAYS" minWidth="10.0" prefWidth="230.0" />
                            </columnConstraints>
                            <rowConstraints>
                                <RowConstraints minHeight="10.0" prefHeight="20.0" vgrow="NEVER" />
                                <RowConstraints minHeight="10.0" prefHeight="20.0" vgrow="NEVER" />
                                <RowConstraints minHeight="10.0" prefHeight="20.0" vgrow="NEVER" />
                                <RowConstraints minHeight="10.0" prefHeight="20.0" vgrow="NEVER" />
                                <RowConstraints minHeight="10.0" prefHeight="20.0" vgrow="NEVER" />
                                <RowConstraints minHeight="10.0" prefHeight="20.0" vgrow="NEVER" />
                            </rowConstraints>
                            <children>

                                <Label text="Nombres:" style="-fx-text-fill: #5c5850;"
                                       GridPane.rowIndex="0" GridPane.columnIndex="0" />
                                <Label fx:id="lblNombres" text="-"
                                       style="-fx-font-weight: bold;"
                                       GridPane.rowIndex="0" GridPane.columnIndex="1" />

                                <Label text="Apellidos:" style="-fx-text-fill: #5c5850;"
                                       GridPane.rowIndex="1" GridPane.columnIndex="0" />
                                <Label fx:id="lblApellidos" text="-"
                                       style="-fx-font-weight: bold;"
                                       GridPane.rowIndex="1" GridPane.columnIndex="1" />

                                <Label text="Tipo de cliente:" style="-fx-text-fill: #5c5850;"
                                       GridPane.rowIndex="2" GridPane.columnIndex="0" />
                                <Label fx:id="lblTipoCliente" text="-"
                                       style="-fx-font-weight: bold;"
                                       GridPane.rowIndex="2" GridPane.columnIndex="1" />

                                <Label text="Ciudad:" style="-fx-text-fill: #5c5850;"
                                       GridPane.rowIndex="3" GridPane.columnIndex="0" />
                                <Label fx:id="lblCiudad" text="-"
                                       style="-fx-font-weight: bold;"
                                       GridPane.rowIndex="3" GridPane.columnIndex="1" />

                                <Label text="Fecha nacimiento:" style="-fx-text-fill: #5c5850;"
                                       GridPane.rowIndex="4" GridPane.columnIndex="0" />
                                <Label fx:id="lblFechaNacimiento" text="-"
                                       style="-fx-font-weight: bold;"
                                       GridPane.rowIndex="4" GridPane.columnIndex="1" />

                                <Label text="Tipo de solicitud:" style="-fx-text-fill: #5c5850;"
                                       GridPane.rowIndex="5" GridPane.columnIndex="0" />
                                <Label fx:id="lblTipoSolicitud" text="-"
                                       style="-fx-font-weight: bold;"
                                       GridPane.rowIndex="5" GridPane.columnIndex="1" />

                            </children>
                        </GridPane>

                    </children>
                </HBox>

                <Separator />

                <Label text="Servicios de interés:" />
                <ListView fx:id="lstServicios" prefHeight="95.0" />

                <Label text="Presione ESC para cerrar esta ventana."
                       style="-fx-text-fill: #5c5850; -fx-font-size: 11px;" />

            </children>
        </VBox>
    </center>

    <bottom>
        <HBox alignment="CENTER_RIGHT" spacing="10.0">
            <padding>
                <Insets bottom="20.0" left="25.0" right="25.0" top="20.0" />
            </padding>
            <children>
                <Button fx:id="btnGuardarImagen" mnemonicParsing="false"
                        onAction="#onGuardarImagen" text="Guardar imagen en..." />
                <Button fx:id="btnCerrar" mnemonicParsing="false"
                        onAction="#onCerrar" prefWidth="100.0" text="Cerrar"
                        cancelButton="true" />
            </children>
        </HBox>
    </bottom>

</BorderPane>