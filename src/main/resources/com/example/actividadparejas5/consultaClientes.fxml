<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="520.0" prefWidth="800.0"
            xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.actividadparejas5.controllers.ConsultaClientesController">

    <top>
        <HBox alignment="BOTTOM_LEFT" spacing="12.0">
            <padding>
                <Insets bottom="12.0" left="25.0" right="25.0" top="20.0" />
            </padding>
            <children>
                <VBox spacing="3.0">
                    <children>
                        <Label text="Buscar:" />
                        <TextField fx:id="txtBuscar" prefWidth="240.0"
                                   promptText="Nombre o ciudad..."
                                   onKeyReleased="#onBuscar" />
                    </children>
                </VBox>
                <Region HBox.hgrow="ALWAYS" />
                <Label fx:id="lblTotalRegistros" text="Total de registros: 0" />
            </children>
        </HBox>
    </top>

    <center>
        <TableView fx:id="tblClientes" onMouseClicked="#onClicTabla">
            <BorderPane.margin>
                <Insets left="25.0" right="25.0" />
            </BorderPane.margin>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
            <placeholder>
                <Label text="No hay clientes registrados todavía." />
            </placeholder>
            <columns>
                <TableColumn fx:id="colNombreCompleto" prefWidth="200.0" text="Nombre completo" />
                <TableColumn fx:id="colTipoCliente" prefWidth="140.0" text="Tipo de cliente" />
                <TableColumn fx:id="colCiudad" prefWidth="120.0" text="Ciudad" />
                <TableColumn fx:id="colFechaNacimiento" prefWidth="140.0" text="Fecha nacimiento" />
                <TableColumn fx:id="colTipoSolicitud" prefWidth="140.0" text="Tipo de solicitud" />
            </columns>
        </TableView>
    </center>

    <bottom>
        <HBox alignment="CENTER_RIGHT" spacing="10.0">
            <padding>
                <Insets bottom="20.0" left="25.0" right="25.0" top="15.0" />
            </padding>
            <children>
                <Label text="Doble clic sobre un registro para ver el detalle."
                       style="-fx-text-fill: #5c5850; -fx-font-size: 11px;" />
                <Region HBox.hgrow="ALWAYS" />
                <Button fx:id="btnRegresar" mnemonicParsing="false"
                        onAction="#onRegresar" prefWidth="100.0" text="Regresar" />
                <Button fx:id="btnEliminar" mnemonicParsing="false"
                        onAction="#onEliminar" prefWidth="100.0" text="Eliminar" />
                <Button fx:id="btnVerDetalle" mnemonicParsing="false"
                        onAction="#onVerDetalle" prefWidth="110.0" text="Ver detalle"
                        defaultButton="true" />
            </children>
        </HBox>
    </bottom>

</BorderPane>